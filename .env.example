# ============================================================
# Scrybe Configuration Environment Template
# Copy this file to .env and fill in your confidential keys
# ============================================================

# LLM Providers & Model Selection
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Model Tier Allocation
EXTRACTION_MODEL=claude-3-5-haiku-20241022
REASONING_MODEL=claude-3-5-sonnet-20241022
EMBEDDING_MODEL=text-embedding-3-small

# Scraping & Network Politeness
USER_AGENT=Scrybe/1.0 (+https://scrybe.ai/bot; contact@scrybe.ai)
MAX_CONCURRENT_SCRAPES=3
CRAWL_DELAY_MIN_SECONDS=2.5
PROXY_URL=

# Storage & Caching
DATABASE_URL=sqlite:///scrybe.db
FAISS_INDEX_PATH=./data/faiss_index.bin
REDIS_URL=redis://localhost:6379/0

# Compliance & Safeguards
RESPECT_ROBOTS_TXT=true
PII_FILTER_ENABLED=true
CONFIDENCE_THRESHOLD=0.60
MULTI_SOURCE_MIN_COUNT=2

# API & Logging
API_PORT=8000
API_KEY=scrybe_secret_dev_key
LOG_LEVEL=INFO
